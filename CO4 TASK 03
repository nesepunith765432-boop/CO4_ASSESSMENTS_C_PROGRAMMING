#include <stdio.h>

enum kind { TEMPERATURE, HUMIDITY, STATUS };

struct reading {
    enum kind type;
    union {
        float celsius;
        int percent;
        char status[8];
    } value;
};

/* Untracked full struct for size comparison (Task 3.1 / 3.2) */
struct full_packet {
    float celsius;
    int percent;
    char status[8];
};

/* TODO 1: Switch on r->type to print only the active union member */
void show(const struct reading *r) {
    switch (r->type) {
        case TEMPERATURE:
            printf("Temp %.1f C\n", r->value.celsius);
            break;
        case HUMIDITY:
            printf("Humidity %d%%\n", r->value.percent);
            break;
        case STATUS:
            printf("Status %s\n", r->value.status);
            break;
    }
}

int main(void) {
    struct reading log[3] = {
        {TEMPERATURE, {.celsius = 31.5f}},
        {HUMIDITY,    {.percent = 68}},
        {STATUS,      {.status = "OK"}}
    };

    printf("sizeof union = %zu, sizeof struct reading = %zu (full struct = %zu)\n",
           sizeof log[0].value, sizeof log[0], sizeof(struct full_packet));

    for (int i = 0; i < 3; i++) {
        show(&log[i]);
    }

    /* Task 3.4: Misuse experiment - store float, read int bits */
    struct reading bad = {TEMPERATURE, {.celsius = 31.5f}};
    printf("Misuse (reading 31.5f as int percent): %d (0x%08X)\n",
           bad.value.percent, (unsigned int)bad.value.percent);

    return 0;
}
