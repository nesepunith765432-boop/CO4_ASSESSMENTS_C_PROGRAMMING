#include <stdio.h>

struct account {
    int number;
    float balance;
};

/* Repaired: takes struct account * so updates modify caller's struct in place */
void addInterest(struct account *a, float rate) {
    printf("  [inside addInterest] addr = %p\n", (void *)a);
    a->balance = a->balance + (a->balance * rate / 100.0f);
}

int main(void) {
    struct account list[3] = {
        {101, 5000.0f},
        {102, 12000.0f},
        {103, 800.0f}
    };
    struct account *p = list;

    for (int i = 0; i < 3; i++) {
        printf("Account %d [in main] addr = %p\n", list[i].number, (void *)&list[i]);
        addInterest(&list[i], 4.0f);
    }

    printf("\nUpdated accounts:\n");
    for (int i = 0; i < 3; i++) {
        printf("Account %d: %.2f\n", (p + i)->number, (p + i)->balance);
    }
    return 0;
}
