#include <stdio.h>
#include <string.h>

struct date {
    int day, month, year;
};

struct address {
    char city[20];
    int pincode;
};

struct parcel {
    int id;
    float weight;
    struct address to;
    struct date booked;
};

/* TODO 1: Print id, weight (1 decimal), city, pincode and booking date using -> */
void print_parcel(const struct parcel *p) {
    printf("%d %.1f kg %s-%d %02d/%02d/%04d\n",
           p->id, p->weight, p->to.city, p->to.pincode,
           p->booked.day, p->booked.month, p->booked.year);
}

/* TODO 2: Selection sort of parcels in ascending order of weight */
void sort_by_weight(struct parcel p[], int n) {
    for (int i = 0; i < n - 1; i++) {
        int min_idx = i;
        for (int j = i + 1; j < n; j++) {
            if (p[j].weight < p[min_idx].weight) {
                min_idx = j;
            }
        }
        if (min_idx != i) {
            struct parcel temp = p[i];
            p[i] = p[min_idx];
            p[min_idx] = temp;
        }
    }
}

void list_by_city(const struct parcel p[], int n, const char *city) {
    printf("\nParcels for %s:\n", city);
    for (int i = 0; i < n; i++) {
        if (strcmp(p[i].to.city, city) == 0) {
            print_parcel(&p[i]);
        }
    }
}

int main(void) {
    struct parcel list[3] = {
        {501, 4.5f, {"Madurai", 625001}, {12, 10, 2026}},
        {502, 1.2f, {"Chennai", 600077}, {12, 10, 2026}},
        {503, 2.8f, {"Coimbatore", 641001}, {13, 10, 2026}}
    };

    /* Access path expressions for Task 2.4 (3rd parcel, index 2):
       (i)  list[2].to.pincode
       (ii) (list + 2)->to.pincode  (or ptr->to.pincode where ptr = &list[2]) */
    struct parcel *ptr = &list[2];
    printf("3rd parcel PIN (dot): %d | (arrow): %d\n",
           list[2].to.pincode, ptr->to.pincode);
    printf("Bytes copied per structure swap: %zu\n\n", sizeof(struct parcel));

    sort_by_weight(list, 3);
    for (int i = 0; i < 3; i++) {
        print_parcel(&list[i]);
    }

    list_by_city(list, 3, "Chennai");
    return 0;
}
