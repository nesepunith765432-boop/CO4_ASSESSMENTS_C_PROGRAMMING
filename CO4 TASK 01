#include <stdio.h>
#include <string.h>

#define MAX_PATIENTS 100

typedef struct {
    int day;
    int month;
    int year;
} Date;

typedef struct {
    int systolic;
    int diastolic;
} BloodPressure;

typedef struct {
    char name[40];
    int age;
    char phone[16];          /* Holds 10 digits + country/null terminator safely */
    BloodPressure bp;
    Date visitDate;
} Patient;

typedef struct {
    Patient records[MAX_PATIENTS];
    int count;
} PatientRegister;

int addPatient(PatientRegister *reg, const Patient *p) {
    if (reg == NULL || p == NULL || reg->count >= MAX_PATIENTS) {
        return 0; /* Bounds check prevents buffer overflow */
    }
    reg->records[reg->count] = *p;
    reg->count++;
    return 1;
}

void sortByAge(PatientRegister *reg) {
    for (int i = 0; i < reg->count - 1; i++) {
        for (int j = 0; j < reg->count - 1 - i; j++) {
            if (reg->records[j].age > reg->records[j + 1].age) {
                Patient temp = reg->records[j];
                reg->records[j] = reg->records[j + 1];
                reg->records[j + 1] = temp;
            }
        }
    }
}

void printRegister(const PatientRegister *reg) {
    for (int i = 0; i < reg->count; i++) {
        const Patient *p = &reg->records[i];
        printf("%-15s | Age: %2d | Phone: %-10s | BP: %3d/%-3d | Date: %02d/%02d/%04d\n",
               p->name, p->age, p->phone,
               p->bp.systolic, p->bp.diastolic,
               p->visitDate.day, p->visitDate.month, p->visitDate.year);
    }
}

int main(void) {
    PatientRegister clinic = { .count = 0 };

    Patient p1 = { "Meena Devi", 54, "9876543210", {130, 85}, {12, 10, 2026} };
    Patient p2 = { "Arjun Kumar", 29, "9123456789", {118, 76}, {12, 10, 2026} };
    Patient p3 = { "Suresh Rao", 67, "9988776655", {142, 90}, {13, 10, 2026} };

    addPatient(&clinic, &p1);
    addPatient(&clinic, &p2);
    addPatient(&clinic, &p3);

    sortByAge(&clinic);
    printf("Patients sorted by age:\n");
    printRegister(&clinic);
    return 0;
}
